# Copy to .env for local development. Never commit .env.
#
# Secrets are read from a mounted DIRECTORY, not from individual mounted files.
# See docs/04-operations.md for why this distinction matters for key rotation.

# Directory containing one file per secret (filename = secret name).
DUVO_SECRETS_DIR=./secrets

# Base URL of the upstream system this server integrates with.
DUVO_UPSTREAM_BASE_URL=http://localhost:8080

# Request timeout in seconds for upstream calls.
DUVO_UPSTREAM_TIMEOUT_SECONDS=10.0

# Logging: json (production) or console (local development).
DUVO_LOG_FORMAT=json
DUVO_LOG_LEVEL=INFO

# Path for the append-only buyer audit log. Empty disables file output and
# routes audit records to the standard logger only.
DUVO_AUDIT_LOG_PATH=./audit.log
